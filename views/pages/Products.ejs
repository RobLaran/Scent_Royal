<div class="products-container wrapper">
    <h1>Manage Products</h1>

    <!-- Add Product Form -->
    <div class="add-product">
      <h2>Add New Product</h2>
      <form>
        <input type="text" placeholder="Product Name" required>
        <input type="number" placeholder="Price" required>
        <input type="number" placeholder="Stock" required>
        <button type="submit">Add Product</button>
      </form>
    </div>

    <!-- Product List -->
    <div class="product-list">
      <h2>Product Inventory</h2>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Product</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1</td>
            <td>Coffee Beans</td>
            <td>₱450</td>
            <td>50</td>
            <td><button class="delete-btn">Remove</button></td>
          </tr>
          <tr>
            <td>2</td>
            <td>Milk Tea</td>
            <td>₱120</td>
            <td>120</td>
            <td><button class="delete-btn">Remove</button></td>
          </tr>
          <tr>
            <td>3</td>
            <td>Chocolate Cake</td>
            <td>₱800</td>
            <td>15</td>
            <td><button class="delete-btn">Remove</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>