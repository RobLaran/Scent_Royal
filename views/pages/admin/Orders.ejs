<div class="admin-orders wrapper">
    <table>
        <tbody>

            <% orders.forEach(order => { %>
                
                <tr class="row-order">
                    <td>#<span><%= order.id %></span></td>
                    <td>
                        <div class="img">
                            <img src="/img/box.png" alt="" />
                        </div>
                    </td>
                    <td>
                        <ul class="products">

                            <% order.items.forEach(item => { %>
                                <li>
                                    <span class="title limit"
                                        ><%= item.title %></span
                                    >
                                    x <span class="quantity"><%= item.quantity %></span>
                                </li>
                            <% }) %>

                        </ul>
                        <div class="no-items">Items: <span><%= order.items.length %></span></div>
                    </td>
                    <td>₱<span class="total"><%= order.total %></span></td>
                    <td>
                        <ul class="info">
                            <% const info = JSON.parse(order.billing_info); %>

                            <li>
                                <strong
                                    ><span class="customer-name limit"
                                        ><%= info.first_name %></span
                                    ></strong
                                >
                            </li>
                            <li>
                                <span class="street-address limit"
                                    ><%= info.street_address %><%= info.house_number ? ', ' + info.house_number : '' %></span
                                >
                            </li>
                            <li>
                                <span class="city-state limit"
                                    ><%= info.city %>, <%= info.country %>, <%= info.post_code %></span
                                >
                            </li>
                            <li>
                                <span class="phone-number limit"><%= info.phone_number %></span>
                            </li>
                        </ul>
                    </td>
                    <td><span class="status status-pending">Pending</span></td>
                    <td>
                        <div class="method">Method: <span><%= info.payment_option %></span></div>
                        <div class="date">Date: <span><%= order.created_at %></span></div>
                    </td>
                    <td></td>
                </tr>

            <% }) %>
            
        </tbody>
    </table>
</div>
